aidl_interface {
    name: "android.hardware.nintendo.joycond",
    vendor_available: true,
    srcs: ["android/**/*.aidl"],
    stability: "vintf",
    backend: {
        java: {
            sdk_version: "module_current",
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
    frozen: true,
}

cc_binary {
    name: "android.hardware.nintendo.joycond-service",
    relative_install_path: "hw",
    init_rc: ["android.hardware.nintendo.joycond-service.rc"],
    vintf_fragments: ["android.hardware.nintendo.joycond-service.xml"],
    vendor: true,
    required: [
        "Vendor_057e_Product_2008.idc",
        "Vendor_057e_Product_2010.idc",
        "Vendor_057e_Product_2008.kl",
    ],
    srcs: [
        "src/*.cpp",
    ],
    local_include_dirs: [
        "include",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libutils",
        "libevdev",
        "libnl",
        "android.hardware.nintendo.joycond-V1-ndk",
    ],
    cppflags: [
        "-std=c++17",
        "-Wno-error",
        "-fexceptions",
        "-O2",
    ]
}

filegroup {
    name: "android.hardware.nintendo.joycond-service.rc",
    srcs: ["android.hardware.nintendo.joycond-service.rc"],
}
