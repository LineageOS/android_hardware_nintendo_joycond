# HwBinder IPC from client to server, and callbacks
binder_call(hal_joycond_client, hal_joycond_server)
binder_call(hal_joycond_server, hal_joycond_client)

add_hwservice(hal_joycond_server, hal_joycond_hwservice)
allow hal_joycond_client hal_joycond_hwservice:hwservice_manager find;
